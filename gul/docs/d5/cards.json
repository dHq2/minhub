[{"id": "ENC-oldman-suit", "sub": "인카운터 · 그림", "name": "노인과 양복", "txt": "", "w": 832, "h": 1216}, {"id": "ENC-giant-head", "sub": "인카운터 · 그림", "name": "거인의 머리", "txt": "", "w": 1216, "h": 832}, {"id": "ENC-beyond", "sub": "인카운터 · 그림", "name": "저 너머", "txt": "", "w": 958, "h": 536}, {"id": "ENC-want-to-tell", "sub": "인카운터 · 그림", "name": "말하고 싶어", "txt": "그는 어둠속에서 기괴한 가면을 쓰고, 그의 머리엔 신성한 붉은 빛이 원을 그립니다. 당신에게 꼭 설명하고 싶을겁니다. 귀신과 당신, 그리고 신에 대하여", "w": 294, "h": 392}, {"id": "ENC-sages", "sub": "인카운터 · 그림", "name": "현자들 (오 닐 · 칼)", "txt": "그들은 여행자를 축복합니다. 우주의 아름다운 빛들이 그들과 함께하고 있었습니다. 그들과 함께하는 모든 순간은 당신의 이성과 빛을 한층 넓혀주고, 그 방의 모든 악한것들은 재처럼 흩어질 뿐이었습니다.", "w": 740, "h": 404}, {"id": "ENC-dead-hero", "sub": "인카운터 · 그림", "name": "죽은 영웅", "txt": "그 영웅은 발부터 세상의 바닥에 얼어붙은듯 묶여있었습니다. 아마 죽은듯 합니다. 그 너머로 원 형태의 빛의 고리, 영웅은 출구를 바라보고 있었습니다. 그의 이야기는 궁금하지만, 우리는 어서 지나가야합니다. 맵 계획: cave-3d/ENCOUNTER_MAPS.md", "w": 340, "h": 450}, {"id": "ENC-brain-frame", "sub": "인카운터 · 그림", "name": "액자 (뇌)", "txt": "머리가 아픕니다. 저들은 당신의 뇌를 액자에 걸어놓고, 그것에 관하여 토론중이었습니다. 돌려받아야합니다. 빨리. 맵 계획: cave-3d/ENCOUNTER_MAPS.md", "w": 316, "h": 338}, {"id": "ENC-chatter", "sub": "인카운터 · 그림", "name": "지껄임 (입)", "txt": "입이 지껄이기 시작합니다. 당신과, 동료들에 대한 모든것들을. 저 입을 닫치게 해야합니다. 오, 진실이란 배신적입니다. 맵 계획: cave-3d/ENCOUNTER_MAPS.md", "w": 334, "h": 306}, {"id": "ENC-ceiling-hole", "sub": "인카운터 · 그림", "name": "천장의 구멍", "txt": "유일한 빛은 천장의 사각형이었습니다. … 날개가 뜯기기 전에. 맵 계획: cave-3d/ENCOUNTER_MAPS.md", "w": 247, "h": 244}, {"id": "ENC-eye-room", "sub": "인카운터 · 그림", "name": "눈알방", "txt": "눈들이 일제히 당신을 쳐다봅니다. 너무 좁습니다. 발을 밟을때마다, 몇개의 눈이 액체를 터뜨리며 깨지고 다시 자라납니다. 그만. 그만 쳐다봐. 맵 계획: cave-3d/ENCOUNTER_MAPS.md", "w": 395, "h": 455}, {"id": "ENC-knowledge-skeleton", "sub": "인카운터 · 그림", "name": "지식의 계단 · 해골", "txt": "", "w": 317, "h": 488}, {"id": "ENC-knowledge-stairs", "sub": "인카운터 · 그림", "name": "지식의 계단 · 직원", "txt": "", "w": 411, "h": 549}, {"id": "ENC-long-beach", "sub": "인카운터 · 그림", "name": "기나긴 해변", "txt": "그는 파도가 치는 해변에 누워있었습니다. 별로 관심이 없는 듯 합니다. 맵 계획: cave-3d/ENCOUNTER_MAPS.md", "w": 337, "h": 315}, {"id": "ENC-altar", "sub": "인카운터 · 그림", "name": "제단", "txt": "세상은 피와 내장이었고, 제단은 불경하게 당신을 바라봅니다. 맵 계획: cave-3d/ENCOUNTER_MAPS.md", "w": 308, "h": 306}, {"id": "ENC-riddle", "sub": "인카운터 · 그림", "name": "수수께끼 (아템)", "txt": "그는 거대한 몸과, 목에 빛나는 보석을 달고 있습니다. 그는 즐거운듯 몸을 움직입니다. \"나의 수수께끼를 풀어다오!\" 장난스러운 그가 심오한 질문들을 준비합니다.. 문제1. 리만가설을 설명하고 해답을 요구 / 문제2. 주의 모든 사건이 물리 법칙으로 정해져 있다면, 인간에게 스스로 선택할 자유가 존재하는가 / 문제3. 무생물인 화학 물질로부터 어떻게 스스로 복제하고 진화하는 최초의 '생명'이 탄생했는가. 무슨 얘기를 하든 땡이다!", "w": 295, "h": 423}, {"id": "ENC-his-face", "sub": "인카운터 · 그림", "name": "그의 얼굴", "txt": "그의 안면이 출구였습니다. 그는 깨달았습니다. 자신의 미래를 직감하고, 누런 눈은 충격으로 물듭니다. 당신이 그에게 저지를 일을 알고 있습니다.", "w": 220, "h": 276}, {"id": "ENC-blue-hero", "sub": "인카운터 · 그림", "name": "푸른 무기의 영웅 (동료 영입 가능)", "txt": "그 영웅은 어둠속에서 푸르게 빛나는 무기를 들었습니다. 즐거운겁니다. 당신의 모든 것이.", "w": 303, "h": 254}, {"id": "ENC-giant-goddess-corpse", "sub": "인카운터 · 그림", "name": "거대 여신 시체", "txt": "", "w": 444, "h": 669}, {"id": "ENC-tehera", "sub": "인카운터 · 그림", "name": "우주의 테헤라 (동료 영입 가능)", "txt": "그것은 잠자리같은 날개와 비현실적인 아름다움으로 어두운 하늘에 빛가루를 흩날립니다. 당신을 흥미롭게 바라봅니다. 필시 어느 종족의 왕이였겠지요. 맵 계획: cave-3d/ENCOUNTER_MAPS.md", "w": 342, "h": 436}, {"id": "ENC-crab-chef", "sub": "인카운터 · 그림", "name": "게 요리사", "txt": "그것은 게.. 이자 사람..이었습니다. 혹시 음식을 사고싶은지, 웃으며 물어봅니다. 요리의 냄새가 납니다. ...재료는 무엇이었을까요?", "w": 318, "h": 366}, {"id": "ENC-distant-god", "sub": "인카운터 · 그림", "name": "감옥의 신", "txt": "별하늘이 빛나는 밤, 저 멀리 한 신이 앉아있습니다. 맙소사. 이곳이 정녕 감옥일까요?", "w": 309, "h": 436}, {"id": "ENC-smoker", "sub": "인카운터 · 그림", "name": "담배 피는 노인", "txt": "어두운 풀숲에서 담배냄새가 납니다. 그는 눈을 꿈뻑거립니다.", "w": 254, "h": 451}, {"id": "ENC-blood-trio", "sub": "인카운터 · 그림", "name": "피의 바다의 셋 (기사 · 신 · 도깨비)", "txt": "피의 바다에서, 세명이 걸어옵니다. 기사와, 신과, 도깨비. 맵 계획: cave-3d/ENCOUNTER_MAPS.md", "w": 399, "h": 531}, {"id": "ENC-white-room", "sub": "인카운터 · 그림", "name": "하얀 방 (흘러넘치는 피)", "txt": "온통 하얀색이었습니다. 질감은 마치 석영처럼 단단했습니다. 성스러운 와인잔에서 피가 조금씩 넘칩니다. 동료중 한명이 경악과 함께 창백해지고 있습니다. 맵 계획: cave-3d/ENCOUNTER_MAPS.md", "w": 311, "h": 337}, {"id": "ENC-rooftops", "sub": "인카운터 · 그림", "name": "빌딩 옥상의 길", "txt": "기괴할정도로 높은, 일정한 간격의, 벽같은 빌딩들이었습니다. 우리는 그 옥상의 열을, 길이라고 착각한 것이었습니다. 이곳에서 떨어지면, 그곳은 평범한 세상일까요. 평범한 사람들이 사는 곳일까요. 그럴리가 없겠죠. 비어있겠죠? 늘 그렇듯 맵 계획: cave-3d/ENCOUNTER_MAPS.md", "w": 318, "h": 399}, {"id": "ENC-conveyor", "sub": "인카운터 · 그림", "name": "끝없는 줄 (컨베이어 벨트)", "txt": "당신은 긴 줄에 서 있습니다. 끝은 보이지 않습니다. 당신의 앞 뒤로 처음 보는 존재들이 미동도 없이 서 있습니다. 그들은 살아있을까요? 맵 계획: cave-3d/ENCOUNTER_MAPS.md", "w": 316, "h": 339}, {"id": "ENC-neon-toilet", "sub": "인카운터 · 그림", "name": "네온 화장실", "txt": "녹슨 벽, 조명, 전화기, 그리고 변기. 뚜껑을 열어볼까요? 맵 계획: cave-3d/ENCOUNTER_MAPS.md", "w": 338, "h": 339}, {"id": "ENC-salt-king", "sub": "인카운터 · 그림", "name": "소금의 왕", "txt": "소금의 왕이 강림하였느니. 당신은 안쪽부터 부식됩니다. 당신의 알량한 의지와 함께.. 맵 계획: cave-3d/ENCOUNTER_MAPS.md", "w": 346, "h": 457}, {"id": "ENC-dancers", "sub": "인카운터 · 그림", "name": "거대한 무희 셋", "txt": "거대한 무희들이 춤을 춥니다. 그들은 무아에 빠져있습니다. 향은 독할정도로 농염합니다. 맵 계획: cave-3d/ENCOUNTER_MAPS.md 무희는 한 명만 잘라 셋으로 복제 (11 가구 · 소품 → 인카운터 오브제 · NPC, H-348)", "w": 318, "h": 424}, {"id": "ENC-pig-god", "sub": "인카운터 · 그림", "name": "돼지들의 신", "txt": "돼지들의 신입니다. 생각보다 다정한 듯 합니다. 냄새는 나지만요, 그건 그렇고, 왜 자꾸 고깃덩이 돼지들을 \"싸는\"겁니까?.... 선물? 충고하자면, 먹지 말지? 맵 계획: cave-3d/ENCOUNTER_MAPS.md", "w": 369, "h": 376}, {"id": "ENC-axe-knight", "sub": "인카운터 · 그림", "name": "푸른 구멍의 도끼기사", "txt": "그 알갱이들의 산 속에서, 푸른 구멍 앞을 그가 지키고 있었습니다. 맵 계획: cave-3d/ENCOUNTER_MAPS.md", "w": 348, "h": 459}, {"id": "C01", "sub": "인카운터 · 카드", "name": "모닥불", "txt": "", "w": 260, "h": 312}, {"id": "C02", "sub": "인카운터 · 카드", "name": "보물상자", "txt": "", "w": 260, "h": 312}, {"id": "C03", "sub": "인카운터 · 카드", "name": "상인", "txt": "", "w": 260, "h": 312}, {"id": "C04", "sub": "인카운터 · 카드", "name": "짐승의 습격", "txt": "", "w": 260, "h": 312}, {"id": "C05", "sub": "인카운터 · 카드", "name": "샘", "txt": "", "w": 260, "h": 312}, {"id": "C06", "sub": "인카운터 · 카드", "name": "함정", "txt": "", "w": 260, "h": 312}, {"id": "C07", "sub": "인카운터 · 카드", "name": "석상", "txt": "", "w": 260, "h": 312}, {"id": "C08