{
  "name": "세희 — 비서 강세희",
  "short_name": "세희",
  "description": "넘긴 것만 아는 비서. 날짜별 판과 안 끝난 일을 이어서 들고 있어요.",
  "lang": "ko",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ece6d4",
  "theme_color": "#ece6d4",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title", "text": "text", "url": "url",
      "files": [ { "name": "files", "accept": ["image/*", "text/*", "application/pdf", "application/*", ".txt", ".pdf", ".docx", ".xlsx", ".pptx", ".hwp", ".hwpx", ".csv", ".md"] } ]
    }
  }
}
